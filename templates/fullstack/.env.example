# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored, and
# `npm run verify` fails if it ever sees a real secret in a tracked file).
#
# Rules of the road:
#  • Only VITE_* variables reach the browser bundle. If a value is secret,
#    it MUST NOT have a VITE_ prefix.
#  • Every variable read by code is declared here with a comment. If you add
#    one, add it here, in `server/_core/env.ts`, and in `scripts/verify.mjs`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Canonical public origin, no trailing slash. Used for cookies, OAuth redirects,
# legal-page links, and email links.
APP_ORIGIN=http://localhost:3000
APP_NAME=Your App
# Who operates the service. Rendered into legal pages and the privacy contact.
OWNER_LEGAL_NAME=Your Company Ltd
OWNER_EMAIL=privacy@example.com
OWNER_ADDRESS=1 Example Street, Example City, Country

# ── Secrets ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating SESSION_SECRET invalidates all existing sessions, by design.
SESSION_SECRET=
CRON_SECRET=

# ── Database (MySQL 8 / MariaDB 10.6+ / TiDB) ───────────────────────────────
# Leave blank to run the app in degraded mode (pages render; DB procedures
# return a clear 503). Handy for UI work before a database exists.
DATABASE_URL=

# ── Auth ────────────────────────────────────────────────────────────────────
# Signup can be closed after you create your own account: set to "invite"
# (requires an invitation row) or "closed" (no new accounts at all).
AUTH_SIGNUP_MODE=open        # open | invite | closed
# Optional OAuth providers. Leave blank to hide the button entirely.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ── Mail ────────────────────────────────────────────────────────────────────
# console = log the message to stdout (default in dev; no mail is sent).
# resend  = https://resend.com REST API (uses MAIL_API_KEY).
# webhook = POST the message to MAIL_WEBHOOK_URL (wire this to your own sender).
MAIL_DRIVER=console
MAIL_FROM="Your App <noreply@example.com>"
MAIL_REPLY_TO=
MAIL_API_KEY=
MAIL_WEBHOOK_URL=

# ── File storage ────────────────────────────────────────────────────────────
# local = write to STORAGE_LOCAL_DIR and serve via /api/files/*  (dev default)
# s3    = any S3-compatible bucket (AWS, R2, MinIO, Wasabi...)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
STORAGE_MAX_UPLOAD_BYTES=10485760
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style is required by MinIO and some R2 setups; keep false for AWS.
S3_FORCE_PATH_STYLE=false

# ── LLM (optional; powers features you build on top of it) ──────────────────
# Any OpenAI-compatible chat-completions endpoint. Leave blank to disable AI
# features cleanly (they return a "not configured" error instead of crashing).
# Example: LLM_BASE_URL=https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Shown in the AI disclosure note required by EU AI Act Art. 50 whenever model
# output is displayed to a user. Keep these accurate — they are user-facing.
LLM_PROVIDER_LABEL=
LLM_PROVIDER_URL=

# ── Analytics (optional, consent-gated) ─────────────────────────────────────
# Leave blank for none. Nothing is sent before the visitor grants consent.
# One of: umami | plausible | none
VITE_ANALYTICS_DRIVER=
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_SITE_ID=

# ── Billing (optional) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Dev server ──────────────────────────────────────────────────────────────
# Comma-separated extra Host headers the dev server accepts (tunnels, previews).
DEV_ALLOWED_HOSTS=


# Demo/preview escape hatch. Production normally refuses to boot when a fatal
# misconfiguration is present (missing SESSION_SECRET, S3 without a bucket, …).
# Set this to true only for throwaway deployments that accept that state.
ALLOW_DEGRADED_BOOT=

COOKIE_SAMESITE=
COOKIE_SECURE=
